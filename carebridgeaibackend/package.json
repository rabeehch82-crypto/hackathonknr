{
  "name": "carebridge-ai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CareBridge AI - Supabase backend (Postgres schema, RLS policies, and Edge Functions)",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "functions:serve": "supabase functions serve --env-file .env",
    "functions:deploy": "supabase functions deploy",
    "secrets:push": "supabase secrets set --env-file .env",
    "link": "supabase link --project-ref $SUPABASE_PROJECT_REF",
    "types:generate": "supabase gen types typescript --local > supabase/types.gen.ts"
  },
  "devDependencies": {
    "supabase": "^1.226.4"
  }
}
